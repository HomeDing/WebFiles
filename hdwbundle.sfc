<sfc tag='hdw-air'>
<template light><u-include ref='#cardHeader'></u-include><div class='main'style='display:flex;flex-wrap:wrap;column-gap:1rem'><div style='flex:1;min-width:8rem;text-align:center;display:none'u-display='temperature'><div style='font-size:2rem'><span>${temperature}</span>&deg;C</div><div>Temperature</div></div><div style='flex:1;min-width:8rem;text-align:center;display:none'u-display='humidity'><div style='font-size:2rem'><span>${humidity}</span>%</div><div>Humidity</div></div><div style='flex:1;min-width:8rem;text-align:center;display:none'u-display='co2'><div style='font-size:2rem'><span>${}</span></div><div>CO2 (ppm)</div></div><div style='flex:1;min-width:8rem;text-align:center;display:none'u-display='pressure'><div style='font-size:2rem'><span>${pressure}</span></div><div>Pressure</div></div><div style='flex:1;min-width:8rem;text-align:center;display:none'u-display='gas'><div style='font-size:2rem'><span>${gas}</span></div><div>VOC</div></div></div></template><script>export default class HDWAir extends HDWGeneric{}</script>
</sfc>
